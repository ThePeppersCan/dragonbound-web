{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dragonbound",
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "dragonbound.repocompany.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist"
  }
}
